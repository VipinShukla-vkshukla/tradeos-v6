# ============================================================
# TradeOS v6 — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── Supabase (Required - Phase 0) ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Google Sheets API (Required - Phase 0) ──────────────────
GOOGLE_SHEET_ID=1yclJSWpRtnenZcd3M1lKbYOnh9CGEnRbMCwlTwv-1Dw
GOOGLE_CREDENTIALS_JSON=credentials/service_account.json

# ── Capital (Required - Phase 0) ────────────────────────────
TOTAL_CAPITAL=200000

# ── AI Providers (Optional - Phase 1) ───────────────────────
# Set whichever you want to use. Leave others blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Telegram (Optional - Phase 1) ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Kite Connect / Zerodha (Optional - Phase 2) ─────────────
KITE_API_KEY=
KITE_API_SECRET=
# KITE_ACCESS_TOKEN is auto-refreshed daily — do not set manually

# ── Misc ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
DRY_RUN=False
TZ=Asia/Kolkata
